{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Tabbycat desktop access for user-selected read-only song folders.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "dialog:default",
    "fs:read-all",
    "fs:allow-watch",
    "fs:allow-unwatch"
  ]
}
